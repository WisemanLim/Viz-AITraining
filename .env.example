# Viz-AITraining — environment template (commit OK, placeholder only)
# Copy to .env.local / .env.dev / .env.staging and fill values.
# .env.prod 는 키 목록만 — Vault/K8s Secret 주입.

APP_NAME=Viz-AITraining
ENV=local

# Database
DATABASE_URL=sqlite:///./local.db
# dev+: postgresql://viz:viz@localhost:5432/viz_ai_training

# Cache — WebSocket live metrics pub/sub across API workers (M1.1 scale-out)
# REDIS_URL=redis://localhost:6379/0

# Object storage (artifacts, checkpoints)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=viz-artifacts

# API
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# WEB_PORT=3000

# Postgres (compose)
# POSTGRES_USER=viz
# POSTGRES_PASSWORD=viz
# POSTGRES_DB=viz_ai_training

# GitHub Pages 배포 (make publish — scripts/publish-pages.sh)
# DEPLOY_ACCOUNT  Pages 소유 계정, DEPLOY_REPO  Pages 저장소명(basePath=/<repo>)
# DEPLOY_ACCOUNT=WisemanLim
# DEPLOY_REPO=viz-ai-training-pages
# DEPLOY_BRANCH=main
# GIT_USER_NAME=viz-ai-training-bot
# GIT_USER_EMAIL=viz-ai-training-bot@users.noreply.github.com
